{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lightning-lang.example/schemas/benchmark-results-v3.json",
  "title": "Lightning benchmark evidence",
  "oneOf": [
    {"$ref": "#/$defs/resultV1"},
    {"$ref": "#/$defs/resultV3"}
  ],
  "$defs": {
    "historicalReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "benchmark",
        "runtime",
        "wall_time_ms",
        "measured_at",
        "kind",
        "comparable_to_current_suite",
        "source"
      ],
      "properties": {
        "benchmark": {"const": "binarytrees"},
        "runtime": {"enum": ["Li", "LuaJIT", "Node"]},
        "wall_time_ms": {"type": "number", "exclusiveMinimum": 0},
        "measured_at": {"const": "2022-06"},
        "kind": {"const": "historical_reference"},
        "comparable_to_current_suite": {"const": false},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "platformV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "version",
        "machine",
        "processor",
        "python_implementation",
        "python_version",
        "logical_cpu_count",
        "execution"
      ],
      "properties": {
        "system": {"type": "string"},
        "release": {"type": "string"},
        "version": {"type": "string"},
        "machine": {"type": "string"},
        "processor": {"type": "string"},
        "python_implementation": {"type": "string"},
        "python_version": {"type": "string"},
        "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1},
        "execution": {"type": "string", "minLength": 1}
      }
    },
    "legacyRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repetition",
        "wall_time_ns",
        "wall_time_ms",
        "exit_code",
        "stdout",
        "stderr",
        "successful"
      ],
      "properties": {
        "repetition": {"type": "integer", "minimum": 1},
        "wall_time_ns": {"type": "integer", "minimum": 0},
        "wall_time_ms": {"type": "number", "minimum": 0},
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "successful": {"type": "boolean"}
      }
    },
    "legacySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_wall_time_ms",
        "median_wall_time_ms",
        "mean_wall_time_ms",
        "maximum_wall_time_ms"
      ],
      "properties": {
        "minimum_wall_time_ms": {"type": "number", "minimum": 0},
        "median_wall_time_ms": {"type": "number", "minimum": 0},
        "mean_wall_time_ms": {"type": "number", "minimum": 0},
        "maximum_wall_time_ms": {"type": "number", "minimum": 0}
      }
    },
    "legacyBenchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "command", "runs", "summary", "successful"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/legacyRun"}},
        "summary": {"$ref": "#/$defs/legacySummary"},
        "successful": {"type": "boolean"}
      }
    },
    "resultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at_utc",
        "suite",
        "executable",
        "mode",
        "repetitions",
        "platform",
        "historical_references",
        "benchmarks",
        "successful"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "suite": {"const": "lightning-p0"},
        "executable": {"type": "string", "minLength": 1},
        "mode": {"enum": ["interpreter", "jit", "auto"]},
        "repetitions": {"type": "integer", "minimum": 1},
        "platform": {"$ref": "#/$defs/platformV1"},
        "historical_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/historicalReference"}
        },
        "benchmarks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/legacyBenchmark"}
        },
        "successful": {"type": "boolean"}
      }
    },
    "platformV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "release",
        "version",
        "machine",
        "processor",
        "python_implementation",
        "python_version",
        "logical_cpu_count"
      ],
      "properties": {
        "system": {"type": "string"},
        "release": {"type": "string"},
        "version": {"type": "string"},
        "machine": {"type": "string"},
        "processor": {"type": "string"},
        "python_implementation": {"type": "string"},
        "python_version": {"type": "string"},
        "logical_cpu_count": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "executionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_wall_time_ns",
        "parse_compile_ns",
        "jit_compile_ns",
        "first_call_ns",
        "warm_call_ns",
        "warm_throughput_per_second",
        "generated_code_bytes",
        "compiled_functions",
        "allocations",
        "retains",
        "releases",
        "spill_slots"
      ],
      "properties": {
        "process_wall_time_ns": {"type": "integer", "minimum": 0},
        "parse_compile_ns": {"type": ["integer", "null"], "minimum": 0},
        "jit_compile_ns": {"type": ["integer", "null"], "minimum": 0},
        "first_call_ns": {"type": ["integer", "null"], "minimum": 0},
        "warm_call_ns": {
          "oneOf": [
            {"type": "null"},
            {"type": "array", "items": {"type": "integer", "minimum": 0}}
          ]
        },
        "warm_throughput_per_second": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "generated_code_bytes": {"type": ["integer", "null"], "minimum": 0},
        "compiled_functions": {"type": ["integer", "null"], "minimum": 0},
        "allocations": {"type": ["integer", "null"], "minimum": 0},
        "retains": {"type": ["integer", "null"], "minimum": 0},
        "releases": {"type": ["integer", "null"], "minimum": 0},
        "spill_slots": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "runV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "iteration",
        "command",
        "metrics",
        "exit_code",
        "timed_out",
        "stdout",
        "stderr",
        "errors",
        "successful"
      ],
      "properties": {
        "kind": {"enum": ["warmup_fresh_process", "measurement_fresh_process"]},
        "iteration": {"type": "integer", "minimum": 1},
        "command": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "metrics": {"$ref": "#/$defs/executionMetrics"},
        "exit_code": {"type": ["integer", "null"]},
        "timed_out": {"type": "boolean"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "errors": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "successful": {"type": "boolean"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_count", "minimum", "median", "mean", "maximum", "unit", "reason"],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "minimum": {"type": ["number", "null"], "minimum": 0},
        "median": {"type": ["number", "null"], "minimum": 0},
        "mean": {"type": ["number", "null"], "minimum": 0},
        "maximum": {"type": ["number", "null"], "minimum": 0},
        "unit": {"enum": ["ns", "calls/second", "bytes", "functions", "allocations", "operations", "slots"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "summarySet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_wall_time_ns",
        "parse_compile_ns",
        "jit_compile_ns",
        "first_call_ns",
        "warm_call_ns",
        "warm_throughput_per_second",
        "generated_code_bytes",
        "compiled_functions",
        "allocations",
        "retains",
        "releases",
        "spill_slots"
      ],
      "properties": {
        "process_wall_time_ns": {"$ref": "#/$defs/summary"},
        "parse_compile_ns": {"$ref": "#/$defs/summary"},
        "jit_compile_ns": {"$ref": "#/$defs/summary"},
        "first_call_ns": {"$ref": "#/$defs/summary"},
        "warm_call_ns": {"$ref": "#/$defs/summary"},
        "warm_throughput_per_second": {"$ref": "#/$defs/summary"},
        "generated_code_bytes": {"$ref": "#/$defs/summary"},
        "compiled_functions": {"$ref": "#/$defs/summary"},
        "allocations": {"$ref": "#/$defs/summary"},
        "retains": {"$ref": "#/$defs/summary"},
        "releases": {"$ref": "#/$defs/summary"},
        "spill_slots": {"$ref": "#/$defs/summary"}
      }
    },
    "benchmarkV3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "command", "warmup_runs", "runs", "summary", "successful"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "command": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "warmup_runs": {"type": "array", "items": {"$ref": "#/$defs/runV3"}},
        "runs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runV3"}},
        "summary": {"$ref": "#/$defs/summarySet"},
        "successful": {"type": "boolean"}
      }
    },
    "timingSemanticsV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_wall_time_ns",
        "parse_compile_ns",
        "jit_compile_ns",
        "first_call_ns",
        "warm_call_ns",
        "warm_throughput_per_second",
        "runtime_counts",
        "warmups"
      ],
      "properties": {
        "process_wall_time_ns": {"const": "process-inclusive runner wall clock: startup, file read, parsing, eager JIT compilation, all requested VM calls, and shutdown"},
        "parse_compile_ns": {"const": "in-process load_script wall clock, including eager JIT compilation"},
        "jit_compile_ns": {"const": "in-process time spent in actual JIT compilation attempts during load and calls"},
        "first_call_ns": {"const": "in-call wall clock for the first entry call in a newly loaded VM"},
        "warm_call_ns": {"const": "per-call in-call wall clocks after the first call, reusing the same loaded VM"},
        "warm_throughput_per_second": {"const": "derived only from the completed warm_call_ns values when more than one in-process call was requested"},
        "runtime_counts": {"const": "per-thread runtime counter deltas across the requested calls in one child process"},
        "warmups": {"const": "discarded fresh child processes; separate from warm calls that reuse a VM inside each child"}
      }
    },
    "resultV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at_utc",
        "suite",
        "executable",
        "build_label",
        "execution_kind",
        "mode",
        "repetitions",
        "warmups",
        "in_process_runs",
        "timeout_seconds",
        "selected_workloads",
        "metrics_requested",
        "verbose_evidence_requested",
        "process_model",
        "timing_semantics",
        "platform",
        "historical_references",
        "benchmarks",
        "successful"
      ],
      "properties": {
        "schema_version": {"const": 3},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "suite": {"const": "lightning-p0"},
        "executable": {"type": "string", "minLength": 1},
        "build_label": {"type": "string", "minLength": 1},
        "execution_kind": {"enum": ["native", "translated"]},
        "mode": {"enum": ["interpreter", "jit", "auto"]},
        "repetitions": {"type": "integer", "minimum": 1},
        "warmups": {"type": "integer", "minimum": 0},
        "in_process_runs": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "selected_workloads": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "binarytrees",
              "fib",
              "nbody",
              "table-heavy",
              "string-heavy",
              "closure-heavy",
              "alloc-heavy",
              "escape",
              "inline",
              "integer-ranges",
              "inline-cache",
              "vectors"
            ]
          }
        },
        "metrics_requested": {"const": true},
        "verbose_evidence_requested": {"type": "boolean"},
        "process_model": {"const": "fresh_process_per_invocation"},
        "timing_semantics": {"$ref": "#/$defs/timingSemanticsV3"},
        "platform": {"$ref": "#/$defs/platformV3"},
        "historical_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/historicalReference"}
        },
        "benchmarks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/benchmarkV3"}
        },
        "successful": {"type": "boolean"}
      }
    }
  }
}
