fn test(a,b,c, ...) {
   assert($VA::len() == 1)
   assert($VA[0] == 4)
   assert($VA[1] == nil)
}
test(1,2,3,4)

fn opt(x, y?) {
   `{x}-{y}`
}
assert(opt(1) == "1-nil")

let missing_argument_error = nil
try {
   opt()
} catch error {
   missing_argument_error = error
}
assert(missing_argument_error is string)